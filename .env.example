# Environment variables for the capstone-prompt-injection project.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Each key is required by a specific part of the pipeline. The notes below
# indicate which scripts or modules need each key.

# Anthropic API key. Required for the Claude Sonnet 4.6 judge (Defense B)
# and for the cheap-judge sweep comparing Sonnet against Haiku 4.5.
# Used by: src/defense_b/judge.py (ClaudeJudge class).
ANTHROPIC_API_KEY=

# OpenAI API key. Required for the GPT-4o sensitivity-check judge and for
# the GPT-4o-mini cost-comparison judge in the sweep.
# Used by: src/defense_b/judge.py (GPT4oJudge class).
OPENAI_API_KEY=

# Groq API key. Required for the Groq-hosted Llama 3.3 70B Versatile agent
# (Defense B agent, sneak-preview-scale work). Has a daily token quota on the
# free / on-demand tier.
# Used by: src/defense_b/agent.py (GroqAgent class).
GROQ_API_KEY=

# Together AI API key. Required for the Together-hosted Llama 3.3 70B
# Instruct Turbo agent (Defense B agent at pilot scale and BIPIA scale, after
# the Groq quota was exhausted mid-project).
# Used by: src/defense_b/agent.py (TogetherAgent class).
TOGETHER_API_KEY=

# OpenRouter API key. Required for the Mistral Large 2 and DeepSeek V3
# agents used in the cross-family stretch-goal evaluation. OpenRouter is a
# meta-provider hosting many model APIs behind one OpenAI-compatible
# endpoint, used here for models that Together AI does not offer
# serverless (Mistral and DeepSeek 70B+ tier).
# Used by: src/defense_b/agent.py (OpenRouterAgent class).
OPENROUTER_API_KEY=

# HuggingFace access token. Required to download the gated Meta Prompt Guard 2
# model (Defense A second classifier). Not required for ProtectAI DeBERTa,
# which is public.
# Used by: src/defense_a/prompt_guard.py.
HF_TOKEN=
